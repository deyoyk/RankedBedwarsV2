{
  "name": "rankedbedwars",
  "version": "2.5.0",
  "description": "Ranked Bedwars System for Discord with websocket support",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --out-dir dist --minify",
    "start": "npm run build && node dist/index.js",
    "start:built": "node dist/index.js",
    "prestart": "node scripts/validate-config.cjs",
    "dev": "ts-node src/index.ts",
    "setup": "node scripts/setup.cjs && node scripts/validate-config.cjs",
    "validate": "node scripts/validate-config.cjs",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "preview": "ts-node preview-local.ts",
    "preview:stats": "ts-node preview-stats.ts",
    "preview:score": "ts-node preview-score.ts",
    "preview:leaderboard": "ts-node preview-leaderboard.ts",
    "preview:start": "ts-node preview-start.ts",
    "test": "jest --runInBand --silent",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "axios": "^1.20.0",
    "canvas": "^3.2.3",
    "chartjs-node-canvas": "^5.0.0",
    "cors": "^2.8.6",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "ioredis": "^6.1.0",
    "mongoose": "^8.24.11",
    "satori": "^0.63.2",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.7",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "canvas@3.2.3": true,
    "esbuild@0.28.2": true
  }
}
