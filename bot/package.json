{
  "name": "rankedbedwars",
  "version": "2.5.0",
  "description": "Ranked Bedwars System for Discord with websocket support",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --out-dir dist --minify",
    "start": "node dist/index.js",
    "prestart": "node scripts/validate-config.cjs",
    "dev": "ts-node src/index.ts",
    "setup": "node scripts/setup.cjs && node scripts/validate-config.cjs",
    "validate": "node scripts/validate-config.cjs",
    "migrate:users": "node scripts/migrateUsers.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "jest --runInBand --silent",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "axios": "^1.20.0",
    "canvas": "^3.2.3",
    "chartjs-node-canvas": "^5.0.0",
    "cors": "^2.8.6",
    "discord.js": "^14.27.0",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "ioredis": "^5.11.1",
    "mongoose": "^8.24.5",
    "node-fetch": "^2.7.0",
    "satori": "^0.62.0",
    "uuid": "^11.1.1",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/node-fetch": "^2.6.13",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "esbuild": "^0.25.12",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "canvas@3.2.3": true,
    "esbuild@0.25.12": true
  }
}
