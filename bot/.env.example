# RANKED BEDWARS DISCORD BOT CONFIGURATION


# AUTH KEY FOR CONNECTING TO THE SOCKET AND API (CHANGE THIS TO SOMETHING RANDOM IN PRODUCTION)
AUTH_KEY=change_me_in_production

# EMBED CONFIGURATION
# These settings control the appearance of embeds sent by the bot
# TEXT: The default message content for the embed (optional)
# COLOR: Hex color code for the embed border
# TITLE: Default title for the embed
# EPHEMERAL: Whether the embed should only be visible to the command user (true/false)
# FOOTER: Footer text that appears at the bottom of embeds
EMBED_DEFAULT_TEXT= 
EMBED_DEFAULT_COLOR=#3498DB
EMBED_DEFAULT_TITLE=Notice
EMBED_DEFAULT_EPHEMERAL=false
EMBED_DEFAULT_FOOTER=deyo Ranked Bedwars

EMBED_ERROR_TEXT=An error occurred.
EMBED_ERROR_COLOR=#E74C3C
EMBED_ERROR_TITLE=Error
EMBED_ERROR_EPHEMERAL=false
EMBED_ERROR_FOOTER=deyo Ranked Bedwars

EMBED_SUCCESS_TEXT=Success!
EMBED_SUCCESS_COLOR=#2ECC71
EMBED_SUCCESS_TITLE=Success
EMBED_SUCCESS_EPHEMERAL=false
EMBED_SUCCESS_FOOTER=deyo Ranked Bedwars


# DISCORD BOT CONFIGURATION
# Essential settings for the Discord bot to connect and function
# DISCORD_TOKEN: Your bot's token from the Discord Developer Portal
# CLIENT_ID: Your bot's application ID from the Discord Developer Portal
# GUILD_ID: The ID of the Discord server where the bot will operate
# PREFIX_ENABLED: Whether to enable message-based commands (true/false)
# PREFIX: The prefix for message-based commands (e.g., !, /, $)
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
PREFIX_ENABLED=true
PREFIX=!


# CHANNEL CONFIGURATION
# IDs for various voice channels used by the bot
# WAITING_ROOM_ID: Default channel where users are moved when they can't join a queue
WAITING_ROOM_ID=


# CATEGORY CONFIGURATION
# IDs for channel categories where game channels will be created
# GAME_CATEGORY_ID: Category where text game channels are created
# VOICE_CATEGORY_ID: Category where team voice channels are created
# SCREEN_SHARE_CATEGORY_ID: Category for screenshare voice channels
GAME_CATEGORY_ID=
VOICE_CATEGORY_ID=
SCREEN_SHARE_CATEGORY_ID=


# CHANNEL CONFIGURATION
# IDs for specific channels where different types of messages are sent
# GAMES_CHANNEL_ID: Channel where game start notifications are posted
# SCORING_CHANNEL_ID: Channel where game results are posted
# VOIDING_CHANNEL_ID: Channel where voided game notifications are posted
# ALERTS_CHANNEL_ID: Channel for general bot alerts and notifications
# PUNISHMENTS_CHANNEL_ID: Channel for punishment notifications
# STRIKE_REQUESTS_CHANNEL_ID: Channel for strike request notifications
# VOID_REQUESTS_CHANNEL_ID: Channel for game void request notifications
# SCREEN_SHARE_REQUESTS_CHANNEL_ID: Channel for screenshare request notifications
# BOT_STATUS_CHANNEL_ID: Channel where bot status updates are posted
GAMES_CHANNEL_ID=
SCORING_CHANNEL_ID=
VOIDING_CHANNEL_ID=
ALERTS_CHANNEL_ID=
PUNISHMENTS_CHANNEL_ID=
STRIKE_REQUESTS_CHANNEL_ID=
VOID_REQUESTS_CHANNEL_ID=
SCREEN_SHARE_REQUESTS_CHANNEL_ID=
BOT_STATUS_CHANNEL_ID=


# ROLE CONFIGURATION
# IDs for various roles used by the bot for permissions and restrictions
# REGISTERED_ROLE_ID: Role given to registered users
# NON_REGISTERED_ROLE_ID: Role for unregistered users
# BANNED_ROLE_ID: Role that restricts access to most features
# MUTED_ROLE_ID: Role that prevents users from sending messages
# SCREEN_SHARER_ROLE_ID: Role that allows screenshare permissions
# FROZEN_ROLE_ID: Role that restricts queue participation
REGISTERED_ROLE_ID=
NON_REGISTERED_ROLE_ID=
BANNED_ROLE_ID=
MUTED_ROLE_ID=
SCREEN_SHARER_ROLE_ID=
FROZEN_ROLE_ID=


# PARTY CONFIGURATION
# Settings related to party system and queue management (players with these roles can bypass PARTY_QUEUE_SIZE limits)
# PARTY_OF_2_ROLE_ID: Role for parties of 2 players
# PARTY_OF_3_ROLE_ID: Role for parties of 3 players
# PARTY_OF_4_ROLE_ID: Role for parties of 4 players

PARTY_OF_2_ROLE_ID=
PARTY_OF_3_ROLE_ID=
PARTY_OF_4_ROLE_ID=

# PARTY_QUEUE_SIZE: Default party queue size limit (for public queues)
# COMMON_PARTY_SIZE: Default party size for common queues (for private games)
PARTY_QUEUE_SIZE=1
COMMON_PARTY_SIZE=8


# WORKER CONFIGURATION
# Settings for multiple bot accounts to handle high load operations
# WORKERS_ENABLED: Whether to use additional bot accounts for operations (true/false)
# WORKER_TOKEN_1: Token for first worker bot account (optional)
# WORKER_TOKEN_2: Token for second worker bot account (optional)
# WORKER_TOKEN_3: Token for third worker bot account (optional)
# WORKER_TOKEN_4: Token for fourth worker bot account (optional)
# WORKER_TOKEN_N: Add as many worker tokens as needed (the system will detect them automatically)
WORKERS_ENABLED=false
WORKER_TOKEN_1=
WORKER_TOKEN_2=
WORKER_TOKEN_3=
WORKER_TOKEN_4=

# DATABASE CONFIGURATION
# REQUIRED: MONGO_URI + DBNAME. WEBSOCKETPORT is the bot<->plugin port (must match plugin bot_url port).
WEBSOCKETPORT=25565
MONGO_URI=mongodb://127.0.0.1:27017/deyorbw
DBNAME=deyorbw
RBW_PUBLIC_API=false


# SERVER INFORMATION
# General information about the server
# SERVER_NAME: Name of your Bedwars server
# INVITE_LINK: Discord invite link for your server
SERVER_NAME=deyo Ranked Bedwars
INVITE_LINK= discord.gg/deyobw
SERVER_IP= play.deyo.lol
BOT_STATS_TEXT= Deyo ranked bedawrs
